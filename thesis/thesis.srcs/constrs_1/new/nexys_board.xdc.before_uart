# CLOCK
set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { CLK100MHZ }]
set_clock_uncertainty 0.5 [get_clocks sys_clk_pin]

set_clock_groups -asynchronous \
  -group [get_clocks -of_objects [get_pins clock_gen/clk_out1]] \
  -group [get_clocks -of_objects [get_pins clock_gen/clk_out3]]

# RESET BUTTON (Active Low CPU Reset)
set_property -dict { PACKAGE_PIN C12 IOSTANDARD LVCMOS33 } [get_ports { RESET }]

# ETHERNET RMII PHY
set_property -dict { PACKAGE_PIN D5  IOSTANDARD LVCMOS33 } [get_ports { ETH_CLKIN }]
set_property -dict { PACKAGE_PIN D9  IOSTANDARD LVCMOS33 } [get_ports { RMII_CRS_DV }]
set_property -dict { PACKAGE_PIN D10 IOSTANDARD LVCMOS33 } [get_ports { RMII_RX_DATA[0] }]
set_property -dict { PACKAGE_PIN C11 IOSTANDARD LVCMOS33 } [get_ports { RMII_RX_DATA[1] }]
set_property -dict { PACKAGE_PIN C10 IOSTANDARD LVCMOS33 } [get_ports { RMII_RX_ERR }]
set_property -dict { PACKAGE_PIN B9  IOSTANDARD LVCMOS33 } [get_ports { RMII_TX_EN }]
set_property -dict { PACKAGE_PIN A10 IOSTANDARD LVCMOS33 } [get_ports { RMII_TX_DATA[0] }]
set_property -dict { PACKAGE_PIN A8  IOSTANDARD LVCMOS33 } [get_ports { RMII_TX_DATA[1] }]
set_property -dict { PACKAGE_PIN B3  IOSTANDARD LVCMOS33 } [get_ports { ETH_RSTN }]
set_property -dict { PACKAGE_PIN B8  IOSTANDARD LVCMOS33 } [get_ports { ETH_INTN }]
set_property -dict { PACKAGE_PIN C9  IOSTANDARD LVCMOS33 } [get_ports { ETH_MDC }]
set_property -dict { PACKAGE_PIN A9  IOSTANDARD LVCMOS33 } [get_ports { ETH_MDIO }]

# LED DIAGNOSTICS
set_property -dict { PACKAGE_PIN T8  IOSTANDARD LVCMOS33 } [get_ports { LED[0] }]
set_property -dict { PACKAGE_PIN V9  IOSTANDARD LVCMOS33 } [get_ports { LED[1] }]
set_property -dict { PACKAGE_PIN R8  IOSTANDARD LVCMOS33 } [get_ports { LED[2] }]
set_property -dict { PACKAGE_PIN T6  IOSTANDARD LVCMOS33 } [get_ports { LED[3] }]
set_property -dict { PACKAGE_PIN T5  IOSTANDARD LVCMOS33 } [get_ports { LED[4] }]
set_property -dict { PACKAGE_PIN T4  IOSTANDARD LVCMOS33 } [get_ports { LED[5] }]
set_property -dict { PACKAGE_PIN U7  IOSTANDARD LVCMOS33 } [get_ports { LED[6] }]
set_property -dict { PACKAGE_PIN U6  IOSTANDARD LVCMOS33 } [get_ports { LED[7] }]
set_property -dict { PACKAGE_PIN V4  IOSTANDARD LVCMOS33 } [get_ports { LED[8] }]
set_property -dict { PACKAGE_PIN U3  IOSTANDARD LVCMOS33 } [get_ports { LED[9] }]
set_property -dict { PACKAGE_PIN V1  IOSTANDARD LVCMOS33 } [get_ports { LED[10] }]
set_property -dict { PACKAGE_PIN R1  IOSTANDARD LVCMOS33 } [get_ports { LED[11] }]
set_property -dict { PACKAGE_PIN P5  IOSTANDARD LVCMOS33 } [get_ports { LED[12] }]
set_property -dict { PACKAGE_PIN U1  IOSTANDARD LVCMOS33 } [get_ports { LED[13] }]
set_property -dict { PACKAGE_PIN R2  IOSTANDARD LVCMOS33 } [get_ports { LED[14] }]
set_property -dict { PACKAGE_PIN P2  IOSTANDARD LVCMOS33 } [get_ports { LED[15] }]
# SEVEN-SEGMENT DISPLAY CATHODES
set_property -dict { PACKAGE_PIN M4  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[0] }]
set_property -dict { PACKAGE_PIN L6  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[1] }]
set_property -dict { PACKAGE_PIN M2  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[2] }]
set_property -dict { PACKAGE_PIN K3  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[3] }]
set_property -dict { PACKAGE_PIN L4  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[4] }]
set_property -dict { PACKAGE_PIN L5  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[5] }]
set_property -dict { PACKAGE_PIN N1  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[6] }]
set_property -dict { PACKAGE_PIN L3  IOSTANDARD LVCMOS33 } [get_ports { SSD_CATHODE[7] }]
# SEVEN-SEGMENT DISPLAY ANODES
set_property -dict { PACKAGE_PIN N6  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[0] }]
set_property -dict { PACKAGE_PIN M6  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[1] }]
set_property -dict { PACKAGE_PIN M3  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[2] }]
set_property -dict { PACKAGE_PIN N5  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[3] }]
set_property -dict { PACKAGE_PIN N2  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[4] }]
set_property -dict { PACKAGE_PIN N4  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[5] }]
set_property -dict { PACKAGE_PIN L1  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[6] }]
set_property -dict { PACKAGE_PIN M1  IOSTANDARD LVCMOS33 } [get_ports { SSD_ANODE[7] }]

# microSD card in SPI mode
set_property -dict { PACKAGE_PIN B1 IOSTANDARD LVCMOS33 } [get_ports { SD_SCK }]
set_property -dict { PACKAGE_PIN C1 IOSTANDARD LVCMOS33 } [get_ports { SD_MOSI }]
set_property -dict { PACKAGE_PIN C2 IOSTANDARD LVCMOS33 } [get_ports { SD_MISO }]
set_property -dict { PACKAGE_PIN D2 IOSTANDARD LVCMOS33 } [get_ports { SD_CS }]
set_property -dict { PACKAGE_PIN A1 IOSTANDARD LVCMOS33 } [get_ports { SD_CD }]
set_property -dict { PACKAGE_PIN E2 IOSTANDARD LVCMOS33 } [get_ports { SD_RESET }]
set_property PULLUP true [get_ports { SD_MISO }]

